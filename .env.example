# ==========================================
# CREDENCIALES DE SUPABASE
# ==========================================
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# ==========================================
# CONFIGURACIÓN API SUNAT (FACTURACIÓN ELECTRÓNICA & GRE)
# ==========================================
# Entorno: BETA (Pruebas) o PRODUCCION (En vivo con SUNAT)
VITE_SUNAT_MODO=BETA

# Datos Fiscales Aurevia
VITE_SUNAT_RUC=20609876541
VITE_SUNAT_RAZON_SOCIAL=AUREVIA BOTANICAL S.A.C.

# Credenciales SOL de SUNAT (Generadas en SUNAT Operaciones en Línea)
VITE_SUNAT_USUARIO_SOL=MODDATOS
VITE_SUNAT_CLAVE_SOL=moddatos

# Token para consultas de padrón RUC / RENIEC vía puente REST (apis.net.pe, decolecta, factiliza...).
# SUNAT no ofrece API pública gratuita. Sin token, el botón "Consultar RUC" sólo valida el
# dígito verificador (módulo 11) de forma local. Para consulta en línea real conviene además
# enrutar la petición por un proxy backend (Supabase Edge Function) y evitar el bloqueo CORS.
VITE_SUNAT_API_TOKEN=tu-token-aqui
