# ==========================================
# MODO DE TRABAJO
# Sin nada configurado la app usa el proyecto de Supabase de producción (src/lib/supabase.ts).
# Para trabajar con datos de ejemplo en el navegador, sin login ni base de datos:
# VITE_MODO=demo
# ==========================================

# ==========================================
# SUPABASE (opcional: para apuntar a otro proyecto; si se definen vacías, modo demo)
# Sólo la URL y la llave PUBLICABLE. Nunca la service_role / secret: toda variable VITE_ queda en la página.
# ==========================================
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica-aqui

# ==========================================
# CONFIGURACIÓN API SUNAT (FACTURACIÓN ELECTRÓNICA & GRE)
# ==========================================
# Entorno: BETA (Pruebas) o PRODUCCION (En vivo con SUNAT)
VITE_SUNAT_MODO=BETA

# Datos Fiscales Aurevia
VITE_SUNAT_RUC=20609876541
VITE_SUNAT_RAZON_SOCIAL=AUREVIA BOTANICAL S.A.C.

# La Clave SOL, el usuario SOL y el token de consulta RUC NO van aquí ni en Vercel:
# toda variable VITE_ se publica dentro de la página. Deben vivir en un servidor (Supabase Edge Function).

